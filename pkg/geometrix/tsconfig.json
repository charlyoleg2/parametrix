{
	"compilerOptions": {
		"target": "esnext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rewriteRelativeImportExtensions": true,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"strict": true,
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"include": ["./src"]
}
